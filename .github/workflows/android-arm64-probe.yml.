name: Android ARM64 Configure Probe

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  configure:
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          submodules: false

      - name: Install build tools
        run: |
          sudo apt-get update
          sudo apt-get install -y cmake ninja-build git python3 unzip

      - name: Install Android NDK
        run: |
          SDK_ROOT="$RUNNER_TEMP/android-sdk"
          mkdir -p "$SDK_ROOT/cmdline-tools"

          curl -fsSL \
            https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
            -o "$RUNNER_TEMP/cmdline-tools.zip"

          unzip -q "$RUNNER_TEMP/cmdline-tools.zip" \
            -d "$RUNNER_TEMP/cmdline-tools"

          mkdir -p "$SDK_ROOT/cmdline-tools/latest"
          mv "$RUNNER_TEMP/cmdline-tools/cmdline-tools/"* \
            "$SDK_ROOT/cmdline-tools/latest/"

          yes | "$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager" \
            --sdk_root="$SDK_ROOT" --licenses >/dev/null

          "$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager" \
            --sdk_root="$SDK_ROOT" \
            "platform-tools" \
            "platforms;android-35" \
            "ndk;27.2.12479018"

          echo "ANDROID_HOME=$SDK_ROOT" >> "$GITHUB_ENV"
          echo "ANDROID_SDK_ROOT=$SDK_ROOT" >> "$GITHUB_ENV"

      - name: Clone pinned ReXGlue SDK
        run: |
          git clone --recursive \
            --branch v0.10.0 \
            https://github.com/rexglue/rexglue-sdk.git \
            third_party/rexglue-sdk

          git -C third_party/rexglue-sdk checkout \
            f5337cdc947ff6d4c4196737e2c807a48f2a1fc2

      - name: Apply MCLA SDK patches
        run: |
          cd third_party/rexglue-sdk

          git apply ../../patches/rexglue-v0.10.0-mcla.patch
          git apply ../../patches/rexglue-minmax-blend-factor.patch

          git -C thirdparty/FFmpeg apply \
            ../../../patches/rexglue-ffmpeg-ps5-config.patch || true

          git apply ../../patches/rexglue-linux-procmap-query.patch
          git apply ../../patches/rexglue-linux-wait-sleep.patch

      - name: Configure SDK for Android ARM64
        id: configure
        continue-on-error: true
        run: |
          set -o pipefail

          SDK="$GITHUB_WORKSPACE/third_party/rexglue-sdk"
          NDK="$ANDROID_SDK_ROOT/ndk/27.2.12479018"

          mkdir -p "$GITHUB_WORKSPACE/android-probe"

          cmake -S "$SDK" \
            -B "$GITHUB_WORKSPACE/android-probe/sdk" \
            -G Ninja \
            -DCMAKE_TOOLCHAIN_FILE="$NDK/build/cmake/android.toolchain.cmake" \
            -DANDROID_ABI=arm64-v8a \
            -DANDROID_PLATFORM=android-26 \
            -DANDROID_STL=c++_shared \
            -DREXGLUE_USE_VULKAN=ON \
            -DREXGLUE_USE_D3D12=OFF \
            -DREXGLUE_ENABLE_TRACY=OFF \
            -DREXGLUE_BUILD_TESTS=OFF \
            -DCMAKE_BUILD_TYPE=Release \
            2>&1 | tee "$GITHUB_WORKSPACE/android-probe/configure.log"

      - name: Generate diagnostic report
        if: always()
        run: |
          OUT="$GITHUB_WORKSPACE/android-probe-report.md"

          {
            echo "# Android ARM64 Configure Probe"
            echo
            echo "This is a diagnostic test, not an APK build."
            echo "No game data is included."
            echo
            echo "## Android platform references in the SDK"

            grep -RInE \
              'if\(ANDROID|REX_PLATFORM_ANDROID|ANativeWindow|AndroidNativeWindowSurface|x11-xcb|wayland-client|surface_gnulinux' \
              third_party/rexglue-sdk/CMakeLists.txt \
              third_party/rexglue-sdk/src \
              third_party/rexglue-sdk/include \
              --exclude-dir=thirdparty 2>/dev/null | head -n 200 || true

            echo
            echo "## CMake configure log"

            if test -f android-probe/configure.log; then
              tail -n 300 android-probe/configure.log
            else
              echo "CMake did not produce a log."
            fi
          } > "$OUT"

          cat "$OUT"

      - name: Upload diagnostic report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: android-arm64-probe-report
          path: |
            android-probe-report.md
            android-probe/configure.log
          if-no-files-found: warn
